---
const features = [
  {
    title: 'Home feed',
    tag: 'DISCOVERY',
    summary: 'Rediscover your own photos and videos in a familiar, endlessly scrollable feed.',
    detail: 'Choose Recent for your newest posts, Rediscover to revisit older memories, or Random for a shuffled view of your library.',
  },
  {
    title: 'Stories & highlights',
    tag: 'MEMORIES',
    summary: 'Revisit memorable moments and enjoy full-screen, tap-through stories.',
    detail: 'Organize story media in a folder’s stories/ directory and use its subfolders for named highlights. Home also surfaces date-based Moments or Highlights, depending on capture-date coverage.',
  },
  {
    title: 'Reels & video streaming',
    tag: 'VIDEO',
    summary: 'Scroll through your videos in an immersive player with on-demand streaming.',
    detail: 'Browse Reels with scrolling or keyboard navigation. New local videos stream by default: compatible originals play directly, while others are converted in short segments as needed. Existing libraries can switch to streaming in Settings.',
  },
  {
    title: 'Carousel posts',
    tag: 'MULTI-MEDIA',
    summary: 'Group related photos, animated images and videos into one swipeable post.',
    detail: 'Each carousel can contain 2–20 supported media files. Organize related memories in carousel folders to browse them together instead of as separate feed posts.',
  },
  {
    title: 'Folder profiles',
    tag: 'ORGANIZATION',
    summary: 'Turn your existing media folders into individual profiles with their own galleries.',
    detail: 'Each indexed local folder containing supported media has its own page, with an editable name and description, cover, post grid and a Reels tab when videos are available. Nested media folders remain separate.',
  },
  {
    title: 'Multiple local galleries',
    tag: 'STORAGE',
    summary: 'Browse photos and videos from multiple drives, NAS mounts and folders in one feed.',
    detail: 'Manage local sources in Settings → Sources. Foldergram indexes accessible media in place without copying originals into a new library. In Docker, mount additional locations before adding them.',
  },
  {
    title: 'Immich integration',
    tag: 'READ-ONLY',
    summary: 'Enjoy Foldergram’s browsing experience with your existing Immich folders and albums.',
    detail: 'Connect an Immich server using an API key and choose which folders or albums to sync. Use Immich alone or alongside local galleries. Foldergram never modifies your Immich originals, and likes and saved collections stay in Foldergram.',
  },
  {
    title: 'Explore, search & library',
    tag: 'BROWSING',
    summary: 'Discover forgotten photos and quickly find folders across your indexed library.',
    detail: 'Explore offers a discovery grid and searches indexed folders by name and path. Library lets you search and sort all indexed folders, loading more results as you browse.',
  },
  {
    title: 'Places',
    tag: 'LOCATION',
    summary: 'Explore memories by location using GPS metadata in your photos.',
    detail: 'Prepare the optional local GeoNames dataset in Settings to group GPS-tagged photos by nearby city. Matching runs locally without an online geocoding service.',
  },
  {
    title: 'Likes & saved collections',
    tag: 'FAVORITES',
    summary: 'Keep your favorite posts close and organize them into saved collections.',
    detail: 'Signed-in admin and viewer sessions share likes and collections stored in local SQLite. In public mode, favorites and collections stay in the current browser.',
  },
  {
    title: 'Access controls',
    tag: 'PRIVACY',
    summary: 'Choose who can browse your gallery and who can manage it.',
    detail: 'Optional password protection separates admin management from viewer access. Public browsing is also available when you choose to allow anyone who can reach your instance to view it. Foldergram does not require individual cloud accounts.',
  },
  {
    title: 'Installable web app',
    tag: 'PWA',
    summary: 'Enjoy a responsive gallery on desktop and mobile, with installable web app support.',
    detail: 'Install Foldergram as a web app in supported browsers. Choose light, dark or system appearance and switch between English, German, Spanish and Chinese.',
  },
];
---
<!-- ================= FEATURES ================= -->
<section class="sec" id="features">
  <div class="wrap">
    <header class="sec-head rv">
      <div class="sh-top"><span class="sec-no">(02)</span><span>FEATURES</span><span class="sh-rule"></span></div>
      <h2>More than a <em class="grad">gallery.</em></h2>
      <p class="sec-sub">An Instagram-inspired photo and video gallery built around your own library. From local folders and Immich to Reels, Stories and saved collections, everything comes together in one self-hosted experience.</p>
    </header>
    <div class="feats" id="feats">
      {features.map((feature, index) => (
        <div class:list={['feat', { open: index === 0 }]}>
          <button class="feat-head" id={`fh${index + 1}`} aria-expanded="true" aria-controls={`fb${index + 1}`}>
            <span class="f-no">{String(index + 1).padStart(2, '0')}</span>
            <span class="f-copy">
              <span class="f-title">{feature.title}</span>
              <span class="f-summary">{feature.summary}</span>
            </span>
            <span class="f-tag">{feature.tag}</span>
            <span class="f-chev"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></span>
          </button>
          <div class="feat-body" id={`fb${index + 1}`} role="region" aria-labelledby={`fh${index + 1}`} aria-hidden="false">
            <div class="fb-in"><div><p>{feature.detail}</p></div></div>
          </div>
        </div>
      ))}
      <a class="feats-more" href="https://docs.foldergram.app/features" target="_blank" rel="noopener">
        Explore all features in the documentation
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
      </a>
    </div>
  </div>
</section>
