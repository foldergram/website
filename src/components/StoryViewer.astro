<!-- ================= STORY VIEWER ================= -->
<div class="sv" id="sv" role="dialog" aria-modal="true" aria-label="Story viewer">
  <div class="sv-bars" id="svBars"></div>
  <div class="sv-top"><button class="sv-close" id="svClose" aria-label="Close story"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
  <div class="sv-stage">
    <button class="sv-arrow prev" id="svPrev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m15 5-7 7 7 7"/></svg></button>
    <div class="sv-card">
      <img id="svImg" alt="">
      <video id="svVideo" muted playsinline preload="metadata" style="display:none;width:100%;height:100%;object-fit:contain" aria-label="Story video"></video>
      <div class="sv-head">
        <span class="ring"><img id="svAv" alt=""></span>
        <span><span class="sv-hn" id="svName"></span><br><span class="sv-hm" id="svMeta"></span></span>
        <span class="sv-hr">
          <button class="iconbtn" id="svDl" aria-label="Download" style="color:#fff"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"/></svg></button>
          <button class="iconbtn" id="svPause" aria-label="Pause story" style="color:#fff"><svg id="svPauseIc" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="5" width="3.4" height="14" rx="1"/><rect x="13.6" y="5" width="3.4" height="14" rx="1"/></svg></button>
          <span class="sv-count" id="svCount"></span>
        </span>
      </div>
      <button class="sv-tap left" id="svTapPrev" aria-label="Previous story item"></button>
      <button class="sv-tap right" id="svTapNext" aria-label="Next story item"></button>
      <div class="sv-foot"><b id="svCap"></b><span id="svDate"></span></div>
    </div>
    <button class="sv-arrow next" id="svNext" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 5 7 7-7 7"/></svg></button>
    <div class="sv-side" id="svSide"></div>
  </div>
</div>
