---
const benefits = [
  'FREE & OPEN SOURCE',
  'SELF-HOSTED',
  'ORIGINALS STAY IN PLACE',
  'MULTIPLE LOCAL GALLERIES',
  'NAS & EXTERNAL DRIVES',
  'READ-ONLY IMMICH INTEGRATION',
  'DOCKER READY',
  'NO CLOUD ACCOUNT REQUIRED',
  'ON-DEMAND VIDEO STREAMING',
];
---
<!-- ================= TICKER ================= -->
<div class="ticker" aria-hidden="true">
  <div class="tk">
    {[0, 1].map(() => (
      <div class="grp">
        {benefits.map(benefit => <><span>{benefit}</span><i>/</i></>)}
      </div>
    ))}
  </div>
</div>
