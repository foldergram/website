---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Foldergram - Self-Hosted Photo & Video Gallery',
  description = 'Rediscover your photos and videos with Foldergram, a free, open-source, self-hosted gallery with an Instagram-inspired feed, Reels, Stories and Immich integration.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const home = new URL('/', Astro.site).href;
const image = new URL('/og.jpg', Astro.site).href;
const imageAlt = 'Foldergram: self-hosted photo and video gallery, with a sample feed of photos and Stories.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': home + '#website',
      name: 'Foldergram',
      url: home,
      inLanguage: 'en',
    },
    {
      '@type': 'SoftwareApplication',
      '@id': home + '#software',
      name: 'Foldergram',
      url: home,
      description,
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Linux (Docker AMD64 and ARM64); web browser for clients',
      license: 'https://github.com/foldergram/foldergram/blob/main/LICENSE',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
      image,
      installUrl: 'https://docs.foldergram.app/installation',
      softwareHelp: 'https://docs.foldergram.app/',
      sameAs: ['https://github.com/foldergram/foldergram', 'https://hub.docker.com/r/sajjadalis/foldergram'],
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Foldergram" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#0a0b10" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-jetbrains" preload />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <script is:inline>
      document.documentElement.classList.add('js-enabled');
      try {
        const theme = localStorage.getItem('fg-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script is:inline src="/interactive-demo.js" defer onerror="document.documentElement.classList.remove('js-enabled')"></script>

  </body>
</html>
