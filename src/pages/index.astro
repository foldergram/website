---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import InteractiveDemo from '../components/InteractiveDemo.astro';
import Ticker from '../components/Ticker.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Philosophy from '../components/Philosophy.astro';
import Specifications from '../components/Specifications.astro';
import OpenSource from '../components/OpenSource.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import StoryViewer from '../components/StoryViewer.astro';
import Lightbox from '../components/Lightbox.astro';
---
<BaseLayout>
  <Header />
  <main>
    <Hero />
    <InteractiveDemo />
    <Ticker />
    <HowItWorks />
    <Features />
    <Philosophy />
    <Specifications />
    <OpenSource />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
  <StoryViewer />
  <Lightbox />
</BaseLayout>
